DEBUG=True
SECRET_KEY=secret
# For Django running on your host. Docker Compose overrides these addresses.
DATABASE_URL=postgres://user:password@127.0.0.1:5432/nameassist
REDIS_URL=redis://127.0.0.1:6380/0
GOOGLE_OAUTH_CLIENT_ID=
PAYSTACK_SECRET_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
# Example: https://<account_id>.r2.cloudflarestorage.com
# Keep preview until the sender domain is verified in Resend.
EMAIL_DELIVERY_MODE=preview
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=NameAssist <nameassist@thisbookiyanga.com>
# Optional: use an inbox you monitor, not an invented address.
EMAIL_REPLY_TO=
EMAIL_LOGO_URL=
# A shared random secret of at least 32 characters; preserve it while mail is pending.
EMAIL_PAYLOAD_ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:5173
# SIRI.DEV
